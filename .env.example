# ============================================================
# REQUIRED
# ============================================================

# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Required Fernet key for database fields and managed local backups.
# Generate a key after running uv sync --locked:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it in a secret store, outside the data volume, with a secure recovery copy.
# Missing, malformed or incompatible keys prevent startup. Preserve an existing
# deployment's key: replacing it does not rotate already encrypted data.
# Server IDs, configured tags, role IDs and counts are encrypted. Guild lookups
# use keyed HMAC indexes. Dates and internal metadata remain visible.
ENCRYPTION_KEY=

# ============================================================
# OPTIONAL
# ============================================================

# Application logging level: DEBUG, INFO, WARNING, ERROR (default: INFO).
# Output contains operational events without Discord identifiers or tag values.
# Raw dependency logs and exception details are suppressed, even with DEBUG.
LOG_LEVEL=INFO

# Log file path (default: bot.log, rotation: 5 MB and 3 rotated files).
# Empty means stdout only. docker-compose.yml sets an empty value and Docker
# rotates its own output. Infrastructure logging remains the operator's choice.
# LOG_FILE=bot.log

# Cache members of monitored servers for member-update handling.
# false saves memory; uncached members depend on daily and manual scans.
# This does not change Gateway intents or provide an individual cache opt-out.
CHUNK_ENABLED_GUILDS=true

# Create consistent snapshots in data/backups/ at startup and every 24 hours.
# Disabling new snapshots does not disable retention or deletion in existing ones.
BACKUP_ENABLED=true
# Maximum daily backup files (default: 7). Backups dated seven or more days
# before the current UTC date are also removed during retention maintenance.
BACKUP_KEEP=7

# Container resource limits (used by docker-compose.yml only).
# Raise MEMORY_LIMIT when monitoring many large servers with chunking enabled.
MEMORY_LIMIT=512M
CPU_LIMIT=0.5

# Heartbeat file used by the container HEALTHCHECK (rarely changed).
# HEARTBEAT_FILE=/tmp/picktag_heartbeat
