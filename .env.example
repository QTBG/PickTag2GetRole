# ============================================================
# REQUIRED
# ============================================================

# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ============================================================
# OPTIONAL — every value below has a sane default
# ============================================================

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Log file path
# Default: bot.log (rotated automatically, 5 MB x 3 files)
# Set to an empty value to log to stdout only (recommended with Docker;
# docker-compose.yml already forces this)
# LOG_FILE=bot.log

# Member cache for real-time detection
# true (default): cache the full member list of servers where monitoring is
# enabled, so tag changes are detected in real time even on large servers
# (>250 members). Costs roughly ~1 KB of RAM per cached member.
# false: rely on the daily scan and /scan for large servers (less RAM).
CHUNK_ENABLED_GUILDS=true

# Database backups
# true (default): consistent snapshot of the database into data/backups/
# at startup then every 24h (one file per day), after an integrity check.
BACKUP_ENABLED=true
# Number of daily backup files to keep (default: 7)
BACKUP_KEEP=7

# Container resource limits (used by docker-compose.yml only)
# Raise MEMORY_LIMIT if you monitor many large servers with chunking enabled.
MEMORY_LIMIT=512M
CPU_LIMIT=0.5

# Heartbeat file used by the container HEALTHCHECK (rarely changed)
# HEARTBEAT_FILE=/tmp/picktag_heartbeat
